{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-page",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "development": {
      "name": "maintenance-page-development",
      "workers_dev": false,
      "preview_urls": false,
      "kv_namespaces": [{ "binding": "MAINTENANCE", "id": "04c15f7fbe8047abb868672e4343c34b" }]
    },
    "production": {
      "name": "maintenance-page-production",
      "workers_dev": false,
      "preview_urls": false,
      "kv_namespaces": [{ "binding": "MAINTENANCE", "id": "04c15f7fbe8047abb868672e4343c34b" }]
    }
  }
}
