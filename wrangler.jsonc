{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-page",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "development": {
      "name": "maintenance-page-development",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "TEAM_DOMAIN": "https://tloi.cloudflareaccess.com",
        "ACCESS_AUD": "*"
      }
    },
    "production": {
      "name": "maintenance-page-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "TEAM_DOMAIN": "https://tloi.cloudflareaccess.com",
        "ACCESS_AUD": "d2b8202a9ae4268043d152968c7139f83fce7c859480b0805201ba950ea91210"
      }
    }
  }
}
